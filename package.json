{
  "name": "quilly",
  "version": "1.0.0",
  "description": "AI-Powered Quilly using RAG, Claude, and CrewAI",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "backend": "node server.js",
    "dev:all": "concurrently \"npm run backend\" \"npm run dev\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "standardize-styles": "node src/utils/stylesStandardiser.js"
  },
  "dependencies": {
    "@ionic/react": "^8.7.7",
    "@ionic/react-router": "^8.7.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "ionicons": "^7.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router": "^5.3.4",
    "react-router-dom": "^5.3.4"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "ts-node": "^10.8.0",
    "typescript": "^5.2.2",
    "vite": "^5.0.8"
  }
}
